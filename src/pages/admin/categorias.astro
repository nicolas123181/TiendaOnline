</style>

<script>
    // ---- Estado global de upload ----
    let isUploading = false;

    // ---- Referencias DOM ----
    const modal = document.getElementById("edit-modal");
    const editBtns = document.querySelectorAll(".edit-btn");
    const closeModal = document.getElementById("close-modal");

    const createFileInput = document.getElementById("create-file-input") as HTMLInputElement | null;
    const createPreview = document.getElementById("create-image-preview");
    const createUrlInput = document.getElementById("create-image-input") as HTMLInputElement | null;
    const createPublicIdInput = document.getElementById("create-image-public-id-input") as HTMLInputElement | null;

    const editFileInput = document.getElementById("edit-file-input") as HTMLInputElement | null;
    const editPreview = document.getElementById("edit-image-preview");
    const editUrlInput = document.getElementById("edit-image-input") as HTMLInputElement | null;
    const editPublicIdInput = document.getElementById("edit-image-public-id-input") as HTMLInputElement | null;

    // ---- Bloquear envío de formularios mientras se sube imagen ----
    document.querySelectorAll("form").forEach((form) => {
        form.addEventListener("submit", (e) => {
            if (isUploading) {
                e.preventDefault();
                alert("Espera a que termine la subida de la imagen antes de guardar.");
            }
        });
    });

    document.querySelectorAll(".confirm-submit-form").forEach((formEl) => {
        const form = formEl as HTMLFormElement;
        form.addEventListener("submit", async (e) => {
            if (form.dataset.confirmed === "true") {
                delete form.dataset.confirmed;
                return;
            }

            e.preventDefault();
            const message =
                form.getAttribute("data-confirm-message") ||
                "¿Confirmar esta acción?";

            const confirmed =
                (await (window as any).vantageConfirm?.(message, {
                    title: "Confirmar eliminación",
                    confirmText: "Eliminar",
                })) ?? confirm(message);

            if (confirmed) {
                form.dataset.confirmed = "true";
                form.submit();
            }
        });
    });

    // ---- Overlay de carga (bloquea toda interacción) ----
    function showUploadingIndicator() {
        const indicator = document.createElement("div");
        indicator.id = "upload-indicator";
        indicator.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;";
        indicator.innerHTML = `
            <div style="background:white;border-radius:16px;padding:2rem;text-align:center;box-shadow:0 25px 50px rgba(0,0,0,0.25);">
                <div style="width:48px;height:48px;border:4px solid #1a2744;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 1rem;"></div>
                <p style="color:#1a2744;font-weight:600;margin:0;">Subiendo imagen...</p>
                <p style="color:#6b7280;font-size:0.85rem;margin-top:0.5rem;">Por favor, espera</p>
            </div>
            <style>@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}</style>
        `;
        document.body.appendChild(indicator);
    }

    function hideUploadingIndicator() {
        document.getElementById("upload-indicator")?.remove();
    }

    // ---- Preview de imagen ----
    function renderPreview(previewEl: HTMLElement | null, imageUrl: string) {
        if (!previewEl) return;
        if (!imageUrl) {
            previewEl.textContent = "Preview";
            return;
        }
        previewEl.innerHTML = "";
        const image = document.createElement("img");
        image.src = imageUrl;
        image.style.width = "100%";
        image.style.height = "100%";
        image.style.objectFit = "cover";
        previewEl.appendChild(image);
    }

    // ---- Upload con protección completa ----
    async function uploadCategoryImage(file: File, previewEl: HTMLElement | null, urlInput: HTMLInputElement | null, publicIdInput: HTMLInputElement | null) {
        if (!file || isUploading) return;

        // Validar tipo
        if (!file.type.startsWith("image/")) {
            alert("El archivo debe ser una imagen");
            return;
        }

        // Validar tamaño (max 10MB)
        if (file.size > 10 * 1024 * 1024) {
            alert("La imagen es demasiado grande. Máximo 10MB.");
            return;
        }

        isUploading = true;
        showUploadingIndicator();

        const form = new FormData();
        form.append("file", file);
        form.append("folder", "categorias");

        try {
            if (previewEl) previewEl.textContent = "Subiendo...";

            const response = await fetch("/api/upload-image", {
                method: "POST",
                body: form,
            });

            const payload = await response.json();

            if (!response.ok) {
                throw new Error(payload.error || "Error subiendo imagen");
            }

            if (urlInput) urlInput.value = payload.url || "";
            if (publicIdInput) publicIdInput.value = payload.publicId || "";
            renderPreview(previewEl, payload.url || "");
        } catch (err: unknown) {
            const error = err instanceof Error ? err : new Error(String(err));
            if (previewEl) previewEl.textContent = "Error";
            alert("Error al subir la imagen: " + (error.message || "Error desconocido"));
        } finally {
            isUploading = false;
            hideUploadingIndicator();
        }
    }

    // ---- Modal de edición ----
    editBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            const name = btn.getAttribute("data-name");
            const description = btn.getAttribute("data-description");
            const imageUrl = btn.getAttribute("data-image-url") || "";
            const imagePublicId = btn.getAttribute("data-image-public-id") || "";

            (document.getElementById("edit-id") as HTMLInputElement).value = id || "";
            (document.getElementById("edit-name") as HTMLInputElement).value = name || "";
            (document.getElementById("edit-description") as HTMLTextAreaElement).value = description || "";
            if (editUrlInput) editUrlInput.value = imageUrl;
            if (editPublicIdInput) editPublicIdInput.value = imagePublicId;
            renderPreview(editPreview, imageUrl);

            if (modal) modal.classList.add("active");
        });
    });

    if (closeModal) {
        closeModal.addEventListener("click", () => {
            if (modal) modal.classList.remove("active");
        });
    }

    if (modal) {
        modal.addEventListener("click", (event) => {
            if (event.target === modal) {
                modal.classList.remove("active");
            }
        });
    }

    // ---- Listeners de file input ----
    if (createFileInput) {
        createFileInput.addEventListener("change", async () => {
            const file = createFileInput.files?.[0];
            if (!file) return;
            await uploadCategoryImage(file, createPreview, createUrlInput, createPublicIdInput);
        });
    }

    if (editFileInput) {
        editFileInput.addEventListener("change", async () => {
            const file = editFileInput.files?.[0];
            if (!file) return;
            await uploadCategoryImage(file, editPreview, editUrlInput, editPublicIdInput);
        });
    }
</script>
