---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase, isSupabaseConfigured } from "../../lib/supabase";
import { deleteImage } from "../../lib/cloudinary";

// Verificar si Supabase está configurado
if (!isSupabaseConfigured) {
    return Astro.redirect("/admin/login?error=config");
}

// Procesar formulario
let message = "";
let messageType: "success" | "error" = "success";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action") as string;

    if (action === "create") {
        const name = formData.get("name") as string;
        const imageUrl = (formData.get("image_url") as string) || null;
        const imagePublicId = (formData.get("image_public_id") as string) || null;
        const description = formData.get("description") as string;
        const slug = name
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/(^-|-$)/g, "");

        const { error } = await supabase
            .from("categories")
            .insert({
                name,
                slug,
                description,
                image_url: imageUrl,
                image_public_id: imagePublicId,
                image_provider: imageUrl ? "cloudinary" : null,
                image_updated_at: imageUrl ? new Date().toISOString() : null,
            });

        if (error) {
            message = `Error al crear categoría: ${error.message}`;
            messageType = "error";
        } else {
            message = "Categoría creada correctamente";
            messageType = "success";
        }
    } else if (action === "update") {
        const id = parseInt(formData.get("id") as string);
        const name = formData.get("name") as string;
        const description = formData.get("description") as string;
        const imageUrl = (formData.get("image_url") as string) || null;
        const imagePublicId = (formData.get("image_public_id") as string) || null;

        const { data: currentCategory } = await supabase
            .from("categories")
            .select("image_public_id")
            .eq("id", id)
            .single();

        const oldPublicId = currentCategory?.image_public_id as string | null;

        const { error } = await supabase
            .from("categories")
            .update({
                name,
                description,
                image_url: imageUrl,
                image_public_id: imagePublicId,
                image_provider: imageUrl ? "cloudinary" : null,
                image_updated_at: new Date().toISOString(),
            })
            .eq("id", id);

        if (error) {
            message = `Error al actualizar categoría: ${error.message}`;
            messageType = "error";
        } else {
            if (oldPublicId && oldPublicId !== imagePublicId) {
                await deleteImage(oldPublicId);
            }
            message = "Categoría actualizada correctamente";
            messageType = "success";
        }
    } else if (action === "delete") {
        const id = parseInt(formData.get("id") as string);

        // Verificar si hay productos en esta categoría
        const { count } = await supabase
            .from("products")
            .select("*", { count: "exact", head: true })
            .eq("category_id", id);

        if (count && count > 0) {
            message = `No se puede eliminar: hay ${count} productos en esta categoría`;
            messageType = "error";
        } else {
            const { data: currentCategory } = await supabase
                .from("categories")
                .select("image_public_id")
                .eq("id", id)
                .single();

            const { error } = await supabase
                .from("categories")
                .delete()
                .eq("id", id);

            if (error) {
                message = `Error al eliminar categoría: ${error.message}`;
                messageType = "error";
            } else {
                if (currentCategory?.image_public_id) {
                    await deleteImage(currentCategory.image_public_id);
                }
                message = "Categoría eliminada correctamente";
                messageType = "success";
            }
        }
    }
}

// Obtener categorías con conteo de productos
const { data: categories } = await supabase
    .from("categories")
    .select(
        `
    *,
    products:products(count)
  `,
    )
    .order("name");

// Parsear el conteo de productos
const categoriesWithCount =
    categories?.map((cat) => ({
        ...cat,
        productCount: cat.products?.[0]?.count || 0,
    })) || [];
---

<AdminLayout title="Gestión de Categorías">
    <div class="page-header">
        <h1><svg class="w-6 h-6 inline -mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg> Gestión de Categorías</h1>
        <p>Administra las categorías de productos de la tienda</p>
    </div>

    {
        message && (
            <div
                class={`alert ${messageType === "error" ? "alert-error" : "alert-success"}`}
            >
                {message}
            </div>
        )
    }

    <!-- Formulario para crear nueva categoría -->
    <div class="card create-form">
        <h2><svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Crear Nueva Categoría</h2>
        <form method="POST">
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="image_url" id="create-image-input" />
            <input
                type="hidden"
                name="image_public_id"
                id="create-image-public-id-input"
            />
            <div class="form-row">
                <div class="form-group">
                    <label for="name">Nombre de la categoría *</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        placeholder="Ej: Camisas"
                    />
                </div>
                <div class="form-group flex-2">
                    <label for="description">Descripción</label>
                    <input
                        type="text"
                        id="description"
                        name="description"
                        placeholder="Descripción breve de la categoría"
                    />
                </div>
                <div class="form-group">
                    <label for="create-file-input">Imagen (opcional)</label>
                    <div style="display:flex;gap:.5rem;align-items:center;">
                        <input type="file" id="create-file-input" accept="image/*" />
                        <div id="create-image-preview" style="width:64px;height:64px;border-radius:8px;background:#f3f4f6;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#9ca3af">Preview</div>
                    </div>
                </div>
                <div class="form-group form-actions">
                    <button type="submit" class="btn btn-primary"
                        >Crear Categoría</button
                    >
                </div>
            </div>
        </form>
    </div>

    <!-- Lista de categorías existentes -->
    <div class="card">
        <h2><svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg> Categorías Existentes ({categoriesWithCount.length})</h2>

        {
            categoriesWithCount.length === 0 ? (
                <div class="empty-state">
                    <p>No hay categorías creadas</p>
                </div>
            ) : (
                <div class="categories-grid">
                    {categoriesWithCount.map((category) => (
                        <div
                            class="category-card"
                            data-id={category.id}
                            data-image-url={
                                category.image_url || category.image || ""
                            }
                            data-image-public-id={
                                category.image_public_id || ""
                            }
                        >
                            {
                                category.image_url || category.image ? (
                                    <div style="margin-bottom:.75rem;">
                                        <img src={category.image_url || category.image} alt={category.name} style="width:100%;height:140px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb" />
                                    </div>
                                ) : null
                            }
                            <div class="category-header">
                                <h3 class="category-name">{category.name}</h3>
                                <span class="product-count">
                                    {category.productCount} productos
                                </span>
                            </div>
                            <p class="category-slug">/{category.slug}</p>
                            <p class="category-description">
                                {category.description || "Sin descripción"}
                            </p>

                            <div class="category-actions">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-secondary edit-btn"
                                    data-id={category.id}
                                    data-name={category.name}
                                    data-description={
                                        category.description || ""
                                    }
                                    data-image-url={
                                        category.image_url ||
                                        category.image ||
                                        ""
                                    }
                                    data-image-public-id={
                                        category.image_public_id || ""
                                    }
                                >
                                    <svg class="w-3.5 h-3.5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg> Editar
                                </button>
                                {category.productCount === 0 ? (
                                    <form
                                        method="POST"
                                        style="display: inline;"
                                        class="confirm-submit-form"
                                        data-confirm-message="¿Seguro que deseas eliminar esta categoría?"
                                    >
                                        <input
                                            type="hidden"
                                            name="action"
                                            value="delete"
                                        />
                                        <input
                                            type="hidden"
                                            name="id"
                                            value={category.id}
                                        />
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                        >
                                            <svg class="w-3.5 h-3.5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg> Eliminar
                                        </button>
                                    </form>
                                ) : (
                                    <button
                                        type="button"
                                        class="btn btn-sm btn-disabled"
                                        disabled
                                        title="Hay productos en esta categoría"
                                    >
                                        <svg class="w-3.5 h-3.5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg> En uso
                                    </button>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            )
        }
    </div>

    <!-- Modal de edición -->
    <div id="edit-modal" class="modal">
        <div class="modal-content">
            <h2><svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg> Editar Categoría</h2>
            <form method="POST">
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" id="edit-id" />
                <input type="hidden" name="image_url" id="edit-image-input" />
                <input
                    type="hidden"
                    name="image_public_id"
                    id="edit-image-public-id-input"
                />
                <div class="form-group">
                    <label for="edit-name">Nombre</label>
                    <input type="text" id="edit-name" name="name" required />
                </div>
                <div class="form-group">
                    <label for="edit-file-input">Imagen (opcional)</label>
                    <div style="display:flex;gap:.5rem;align-items:center;">
                        <input type="file" id="edit-file-input" accept="image/*" />
                        <div id="edit-image-preview" style="width:64px;height:64px;border-radius:8px;background:#f3f4f6;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#9ca3af">Preview</div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="edit-description">Descripción</label>
                    <textarea id="edit-description" name="description" rows="3"
                    ></textarea>
                </div>
                <div class="modal-actions">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        id="close-modal">Cancelar</button
                    >
                    <button type="submit" class="btn btn-primary"
                        >Guardar Cambios</button
                    >
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<style>
