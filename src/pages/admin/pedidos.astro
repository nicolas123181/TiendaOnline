                                            #
                                            {order.id
                                                .toString()
                                                .padStart(5, "0")}
                                        </span>
                                        <span
                                            class={`px-3 py-1 text-xs font-semibold rounded-full ${statusColors[order.status]}`}
                                        >
                                            {statusLabels[order.status]}
                                        </span>
                                        <span class="text-sm text-gray-500">
                                            {new Date(
                                                order.created_at,
                                            ).toLocaleDateString("es-ES", {
                                                day: "numeric",
                                                month: "short",
                                                hour: "2-digit",
                                                minute: "2-digit",
                                            })}
                                        </span>
                                    </div>
                                    <p class="text-gray-900 font-medium">
                                        {order.customer_name}
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        {order.customer_email}
                                    </p>

                                    <div class="mt-2 text-sm text-gray-700 bg-blue-50 rounded-lg p-3">
                                        <p class="font-medium flex items-center gap-1">
                                            <svg class="w-4 h-4 text-blue-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                                            {order.customer_address}
                                        </p>
                                        <p>
                                            {order.customer_postal_code}{" "}
                                            {order.customer_city}
                                        </p>
                                        {order.customer_phone && (
                                            <p>Tel: {order.customer_phone}</p>
                                        )}
                                    </div>

                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {order.order_items
                                            ?.slice(0, 3)
                                            .map((item: any) => (
                                                <span class="text-xs bg-gray-100 px-2 py-1 rounded">
                                                    {item.product_name} ×{" "}
                                                    {item.quantity}
                                                </span>
                                            ))}
                                        {order.order_items?.length > 3 && (
                                            <span class="text-xs text-gray-500">
                                                +{order.order_items.length - 3}{" "}
                                                más
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <div class="text-right">
                                    <p class="text-xl font-bold text-gray-900">
                                        {formatPrice(order.total)}
                                    </p>
                                    <p class="text-sm text-gray-500">
                                        {order.order_items?.length || 0}{" "}
                                        producto(s)
                                    </p>

                                    {order.status === "paid" && (
                                        <button
                                            type="button"
                                            class="mt-4 w-full px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shipping-action-btn"
                                            data-order={order.id}
                                            data-email={order.customer_email}
                                            data-name={order.customer_name}
                                            data-type="shipping"
                                        >
                                            <svg class="w-4 h-4 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Listo
                                        </button>
                                    )}
                                    {order.status === "shipped" && (
                                        <button
                                            type="button"
                                            class="mt-4 w-full px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors action-btn"
                                            data-order={order.id}
                                            data-action="delivered"
                                            data-email={order.customer_email}
                                            data-name={order.customer_name}
                                        >
                                            <svg class="w-4 h-4 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Entregado
                                        </button>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )
        }
    </section>

    <!-- SECCIÓN 3: RECOGIDA EN TIENDA -->
    <section class="mb-10">
        <h2
            class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2"
        >
            <span
                class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center"
                ><svg class="w-4 h-4 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg></span
            >
            Recogida en Tienda
            <span class="text-sm font-normal text-gray-500"
                >({pickupOrders.length})</span
            >
        </h2>

        {
            pickupOrders.length === 0 ? (
                <div class="bg-gray-50 rounded-xl p-8 text-center text-gray-500">
                    No hay pedidos de recogida pendientes
                </div>
            ) : (
                <div class="space-y-4">
                    {pickupOrders.map((order) => (
                        <div
                            class="bg-white rounded-xl shadow-sm border border-orange-100 p-4 sm:p-6"
                            data-order-id={order.id}
                        >
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="font-mono font-bold text-lg text-blue-900">
                                            #
                                            {order.id
                                                .toString()
                                                .padStart(5, "0")}
                                        </span>
                                        <span
                                            class={`px-3 py-1 text-xs font-semibold rounded-full ${statusColors[order.status]}`}
                                        >
                                            {statusLabels[order.status]}
                                        </span>
                                        <span class="text-sm text-gray-500">
                                            {new Date(
                                                order.created_at,
                                            ).toLocaleDateString("es-ES", {
                                                day: "numeric",
                                                month: "short",
                                                hour: "2-digit",
                                                minute: "2-digit",
                                            })}
                                        </span>
                                    </div>
                                    <p class="text-gray-900 font-medium">
                                        {order.customer_name}
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        {order.customer_email}
                                    </p>
                                    {order.customer_phone && (
                                        <p class="text-sm text-gray-500">
                                            Tel: {order.customer_phone}
                                        </p>
                                    )}

                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {order.order_items
                                            ?.slice(0, 3)
                                            .map((item: any) => (
                                                <span class="text-xs bg-gray-100 px-2 py-1 rounded">
                                                    {item.product_name} ×{" "}
                                                    {item.quantity}
                                                </span>
                                            ))}
                                        {order.order_items?.length > 3 && (
                                            <span class="text-xs text-gray-500">
                                                +{order.order_items.length - 3}{" "}
                                                más
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <div class="text-right">
                                    <p class="text-xl font-bold text-gray-900">
                                        {formatPrice(order.total)}
                                    </p>
                                    <p class="text-sm text-gray-500">
                                        {order.order_items?.length || 0}{" "}
                                        producto(s)
                                    </p>

                                    {order.status === "paid" && (
                                        <button
                                            type="button"
                                            class="mt-4 w-full px-4 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700 transition-colors action-btn"
                                            data-order={order.id}
                                            data-action="ready_for_pickup"
                                            data-email={order.customer_email}
                                            data-name={order.customer_name}
                                        >
                                            <svg class="w-4 h-4 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Listo
                                        </button>
                                    )}
                                    {order.status === "ready_for_pickup" && (
                                        <button
                                            type="button"
                                            class="mt-4 w-full px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors action-btn"
                                            data-order={order.id}
                                            data-action="delivered"
                                            data-email={order.customer_email}
                                            data-name={order.customer_name}
                                        >
                                            <svg class="w-4 h-4 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Entregado
                                        </button>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )
        }
    </section>

    <!-- SECCIÓN 4: PEDIDOS COMPLETADOS -->
    <section class="mt-12 pt-12 border-t-4 border-green-200">
        <div class="flex items-center gap-3 mb-6">
            <div
                class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center"
            >
                <svg
                    class="w-6 h-6 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-900">
                    <svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Pedidos Completados
                </h2>
                <p class="text-sm text-gray-600">
                    Pedidos entregados o cancelados ({allOrders.length} pedidos)
                </p>
            </div>
        </div>

        <!-- Búsqueda y filtros -->
        <div
            class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6"
        >
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                        >Buscar por ID</label
                    >
                    <div class="relative">
                        <input
                            type="text"
                            id="search-id"
                            placeholder="Ej: 00001"
                            class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        />
                        <svg
                            class="w-5 h-5 text-gray-400 absolute left-3 top-2.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                        >Filtrar por estado</label
                    >
                    <select
                        id="filter-status"
                        class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    >
                        <option value="">Todos los completados</option>
                        <option value="delivered">Entregado</option>
                        <option value="cancelled">Cancelado</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tabla de pedidos -->
        <div
            class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden"
        >
            <div class="pedidos-table-wrapper">
                <table class="w-full pedidos-table">
                    <thead class="bg-gray-50">
                        <tr>
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >ID</th
                            >
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >Cliente</th
                            >
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >Estado</th
                            >
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >Total</th
                            >
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >Fecha</th
                            >
                            <th
                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                >Productos</th
                            >
                        </tr>
                    </thead>
                    <tbody
                        id="orders-table-body"
                        class="divide-y divide-gray-100"
                    >
                        {
                            allOrders.map((order) => (
                                <tr
                                    class="hover:bg-gray-50 order-row"
                                    data-id={order.id}
                                    data-status={order.status}
                                >
                                    <td class="px-4 py-4" data-label="ID">
                                        <span class="font-mono font-bold text-blue-900">
                                            #
                                            {order.id
                                                .toString()
                                                .padStart(5, "0")}
                                        </span>
                                    </td>
                                    <td class="px-4 py-4" data-label="Cliente">
                                        <p class="font-medium text-gray-900">
                                            {order.customer_name}
                                        </p>
                                        <p class="text-sm text-gray-500">
                                            {order.customer_email}
                                        </p>
                                    </td>
                                    <td class="px-4 py-4" data-label="Estado">
                                        <span
                                            class={`px-2 py-1 text-xs font-semibold rounded-full ${statusColors[order.status] || "bg-gray-100 text-gray-800"}`}
                                        >
                                            {statusLabels[order.status] ||
                                                order.status}
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 font-semibold" data-label="Total">
                                        {formatPrice(order.total)}
                                    </td>
                                    <td class="px-4 py-4 text-sm text-gray-500" data-label="Fecha">
                                        {new Date(
                                            order.created_at,
                                        ).toLocaleDateString("es-ES", {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric",
                                        })}
                                    </td>
                                    <td class="px-4 py-4 text-sm text-gray-600" data-label="Productos">
                                        {order.order_items?.length || 0} item(s)
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            {
                allOrders.length === 0 && (
                    <div class="p-8 text-center text-gray-500">
                        No hay pedidos completados
                    </div>
                )
            }
        </div>
    </section>

    <!-- MODAL DE ENVÍO -->
    <div
        id="shipping-modal"
        class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden"
    >
        <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl">
            <h3
                class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2"
            >
                <svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2-1 2 1 2-1 2 1m0 0V6m0 10l2-1 2 1 2-1 2 1V6a1 1 0 00-1-1h-4a1 1 0 00-1 1"/></svg> Información de Envío
            </h3>

            <form id="shipping-form" class="space-y-5">
                <input type="hidden" id="modal-order-id" />
                <input type="hidden" id="modal-customer-email" />
                <input type="hidden" id="modal-customer-name" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Empresa de Transporte *
                    </label>
                    <select
                        id="carrier-select"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    >
                        <option value="">Selecciona un distribuidor</option>
                        {
                            (shippingCarriers || []).map((carrier: any) => (
                                <option
                                    value={carrier.id}
                                    data-tracking-url={
                                        carrier.tracking_url_template
                                    }
                                >
                                    {carrier.name}
                                </option>
                            ))
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Número de Seguimiento *
                    </label>
                    <input
                        type="text"
                        id="tracking-number"
                        required
                        placeholder="Ej: 1Z999AA10123456784"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                    <p class="text-xs text-gray-500 mt-1">
                        El cliente recibirá un email con este número
                    </p>
                </div>

                <div class="flex gap-3 pt-4">
                    <button
                        type="button"
                        id="cancel-modal"
                        class="flex-1 px-4 py-3 border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-colors"
                    >
                        Cancelar
                    </button>
                    <button
                        type="submit"
                        class="flex-1 px-4 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors"
                    >
                        Confirmar Envío
                    </button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<style>
    @media (max-width: 768px) {
        /* Order cards: stack content vertically */
        [data-order-id] > div {
            flex-direction: column !important;
            gap: 0.75rem !important;
        }
        [data-order-id] .text-right {
            text-align: left !important;
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
        }
        [data-order-id] .text-right .text-xl {
            font-size: 1.1rem !important;
        }
        [data-order-id] .text-right button {
            width: 100% !important;
        }

        /* Badge row wrapping */
        [data-order-id] .flex.items-center.gap-3 {
            flex-wrap: wrap;
        }

        /* Historical orders table: card layout */
        .pedidos-table thead {
            display: none;
        }
        .pedidos-table tbody {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 1rem;
        }
        .pedidos-table tbody tr {
            display: flex;
            flex-direction: column;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }
        .pedidos-table tbody td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 1rem;
            border-bottom: 1px solid #f3f4f6;
        }
        .pedidos-table tbody td:last-child {
            border-bottom: none;
        }
        .pedidos-table tbody td::before {
            content: attr(data-label);
            font-weight: 600;
            font-size: 0.75rem;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            flex-shrink: 0;
            margin-right: 1rem;
        }
        .pedidos-table tbody td p.text-sm {
            word-break: break-all;
        }

        /* Modal */
        #shipping-modal > div {
            margin: 1rem;
            max-width: calc(100% - 2rem);
        }
    }
</style>

<script>
    // Modal de envío
    const shippingModal = document.getElementById("shipping-modal");
    const shippingForm = document.getElementById("shipping-form");
    const cancelModalBtn = document.getElementById("cancel-modal");

    // Botones de envío (abren modal)
    document.querySelectorAll(".shipping-action-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const button = e.target as HTMLButtonElement;
            const orderId = button.dataset.order;
            const email = button.dataset.email;
            const name = button.dataset.name;

            // Rellenar datos del modal
            (
                document.getElementById("modal-order-id") as HTMLInputElement
            ).value = orderId || "";
            (
                document.getElementById(
                    "modal-customer-email",
                ) as HTMLInputElement
            ).value = email || "";
            (
                document.getElementById(
                    "modal-customer-name",
                ) as HTMLInputElement
            ).value = name || "";

            // Mostrar modal
            shippingModal?.classList.remove("hidden");
        });
    });

    // Cerrar modal
    cancelModalBtn?.addEventListener("click", () => {
        shippingModal?.classList.add("hidden");
    });

    shippingModal?.addEventListener("click", (e) => {
        if (e.target === shippingModal) {
            shippingModal.classList.add("hidden");
        }
    });

    // Enviar formulario de envío
    shippingForm?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const orderId = (
            document.getElementById("modal-order-id") as HTMLInputElement
        ).value;
        const email = (
            document.getElementById("modal-customer-email") as HTMLInputElement
        ).value;
        const name = (
            document.getElementById("modal-customer-name") as HTMLInputElement
        ).value;
        const carrierId = (
            document.getElementById("carrier-select") as HTMLSelectElement
        ).value;
        const carrierName =
            (document.getElementById("carrier-select") as HTMLSelectElement)
                .selectedOptions[0]?.text || "";
        const trackingNumber = (
            document.getElementById("tracking-number") as HTMLInputElement
        ).value;
        const trackingUrlTemplate =
            (document.getElementById("carrier-select") as HTMLSelectElement)
                .selectedOptions[0]?.dataset.trackingUrl || "";

        const submitBtn = shippingForm.querySelector(
            'button[type="submit"]',
        ) as HTMLButtonElement;
        submitBtn.disabled = true;
        submitBtn.textContent = "Procesando...";

        try {
            const response = await fetch("/api/admin/update-order-status", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    orderId: parseInt(orderId),
                    status: "shipped",
                    customerEmail: email,
                    customerName: name,
                    carrierId: parseInt(carrierId),
                    carrierName,
                    trackingNumber,
                    trackingUrlTemplate,
                }),
            });

            const result = await response.json();

            if (result.success) {
                shippingModal?.classList.add("hidden");

                const successMsg = document.getElementById("success-message");
                const successText = document.getElementById("success-text");
                if (successMsg && successText) {
                    successText.textContent =
                        "Pedido enviado. Email con tracking enviado al cliente.";
                    successMsg.classList.remove("hidden");
                }

                // Ocultar pedido de la lista
                const orderCard = document.querySelector(
                    `[data-order-id="${orderId}"]`,
                );
                if (orderCard) {
                    orderCard.classList.add(
                        "opacity-50",
                        "pointer-events-none",
                    );
                    setTimeout(() => location.reload(), 1500);
                }
            } else {
                throw new Error(result.error || "Error al actualizar");
            }
        } catch (error) {
            const errorMsg = document.getElementById("error-message");
            const errorText = document.getElementById("error-text");
            if (errorMsg && errorText) {
                errorText.textContent = (error as Error).message;
                errorMsg.classList.remove("hidden");
            }
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = "Confirmar Envío";
        }
    });

    // Botones de acción directa (recogida en tienda)
    document.querySelectorAll(".action-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
            const button = e.target as HTMLButtonElement;
            const orderId = button.dataset.order;
            const action = button.dataset.action;
            const email = button.dataset.email;
            const name = button.dataset.name;

            if (!orderId || !action) return;

            const actionLabels: Record<string, string> = {
                ready_for_pickup: "marcar como listo para recoger",
                delivered: "marcar como entregado",
            };

            if (
                !confirm(
                    `¿Confirmar ${actionLabels[action] || action}?\n\nSe enviará un email a ${email}`,
                )
            ) {
                return;
            }

            button.disabled = true;
            button.textContent = "Procesando...";

            try {
                const response = await fetch("/api/admin/update-order-status", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        orderId: parseInt(orderId),
                        status: action,
                        customerEmail: email,
                        customerName: name,
                    }),
                });

                const result = await response.json();

                if (result.success) {
                    const successMsg =
                        document.getElementById("success-message");
                    const successText = document.getElementById("success-text");
                    if (successMsg && successText) {
                        successText.textContent =
                            result.message ||
                            "Pedido actualizado y email enviado";
                        successMsg.classList.remove("hidden");
                    }

                    const orderCard = button.closest("[data-order-id]");
                    if (orderCard) {
                        orderCard.classList.add(
                            "opacity-50",
                            "pointer-events-none",
                        );
                        setTimeout(() => location.reload(), 1500);
                    }
                } else {
                    throw new Error(result.error || "Error al actualizar");
                }
            } catch (error) {
                const errorMsg = document.getElementById("error-message");
                const errorText = document.getElementById("error-text");
                if (errorMsg && errorText) {
                    errorText.textContent = (error as Error).message;
                    errorMsg.classList.remove("hidden");
                }
                button.disabled = false;
                button.textContent =
                    button.textContent?.replace("Procesando...", "") ||
                    "Reintentar";
            }
        });
    });

    // Filtrado de la tabla
    const searchInput = document.getElementById(
        "search-id",
    ) as HTMLInputElement;
    const statusFilter = document.getElementById(
        "filter-status",
    ) as HTMLSelectElement;
    const orderRows = document.querySelectorAll(".order-row");

    function filterOrders() {
        const searchValue =
            searchInput?.value.toLowerCase().replace("#", "") || "";
        const statusValue = statusFilter?.value || "";

        orderRows.forEach((row) => {
            const rowElement = row as HTMLElement;
            const orderId = rowElement.dataset.id || "";
            const orderStatus = rowElement.dataset.status || "";

            const matchesId =
                searchValue === "" ||
                orderId.includes(searchValue) ||
                orderId.padStart(5, "0").includes(searchValue);
            const matchesStatus =
                statusValue === "" || orderStatus === statusValue;

            rowElement.style.display = matchesId && matchesStatus ? "" : "none";
        });
    }

    searchInput?.addEventListener("input", filterOrders);
    statusFilter?.addEventListener("change", filterOrders);
</script>
