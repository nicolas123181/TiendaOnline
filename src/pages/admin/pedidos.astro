                            class="bg-white rounded-xl shadow-sm border border-blue-100 p-4 sm:p-6"
                            data-order-id={order.id}
                        >
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
