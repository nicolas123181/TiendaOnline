<script>
    // Actualizar hint según tipo de descuento
    const discountType = document.getElementById(
        "discount_type",
    ) as HTMLSelectElement;
    const discountHint = document.getElementById("discount-hint");
    const discountValue = document.getElementById(
        "discount_value",
    ) as HTMLInputElement;

    discountType?.addEventListener("change", () => {
        if (discountType.value === "percentage") {
            discountHint!.textContent = "Porcentaje de descuento (1-100)";
            discountValue.max = "100";
            discountValue.placeholder = "Ej: 15";
        } else {
            discountHint!.textContent = "Cantidad en euros";
            discountValue.removeAttribute("max");
            discountValue.placeholder = "Ej: 10";
        }
    });
</script>
