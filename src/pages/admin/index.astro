<script>
    // ── Wishlist Automation Panel ──────────────────────────────────────────
    type WishlistNotif = {
        user_email?: string;
        product_name?: string;
        size?: string;
        size_stock?: number;
        discount_percentage?: number;
        [key: string]: unknown;
    };

    async function loadWishlistStatus() {
        const refreshIcon = document.getElementById('wishlist-refresh-icon');
        refreshIcon?.classList.add('animate-spin');

        try {
            const [lowStockRes, saleRes] = await Promise.all([
                fetch('/api/admin/wishlist-notifications', { credentials: 'include' }),
                fetch('/api/admin/wishlist-sale-notifications', { credentials: 'include' }),
            ]);

            // Low stock
            if (lowStockRes.ok) {
                const data = await lowStockRes.json() as { pendingNotifications: number; notifications: WishlistNotif[] };
                const count = data.pendingNotifications ?? 0;
                const badge = document.getElementById('lowstock-badge');
                const status = document.getElementById('lowstock-status');
                const preview = document.getElementById('lowstock-preview');
                if (badge) badge.textContent = String(count);
                if (status) status.textContent = count === 0
                    ? 'No hay notificaciones pendientes de stock bajo.'
                    : `${count} usuario(s) con artículos en favoritos con poco stock.`;
                if (preview && data.notifications?.length > 0) {
                    preview.innerHTML = data.notifications.slice(0, 5).map((n: WishlistNotif) =>
                        `<div class="flex items-center justify-between bg-amber-50 border border-amber-100 rounded-lg px-3 py-1.5 gap-2">
                            <span class="text-amber-800 font-medium truncate">${n.product_name ?? ''}</span>
                            <span class="text-amber-600 shrink-0">T.${n.size ?? ''} · ${n.size_stock ?? 0} ud${(n.size_stock ?? 0) === 1 ? '' : 's'}</span>
                        </div>`
                    ).join('');
                    preview.classList.remove('hidden');
                } else if (preview) {
                    preview.classList.add('hidden');
                }
            }

            // Sale
            if (saleRes.ok) {
                const data = await saleRes.json() as { pendingNotifications: number; notifications: WishlistNotif[] };
                const count = data.pendingNotifications ?? 0;
                const badge = document.getElementById('sale-badge');
                const status = document.getElementById('sale-status');
                const preview = document.getElementById('sale-preview');
                if (badge) badge.textContent = String(count);
                if (status) status.textContent = count === 0
                    ? 'No hay notificaciones de oferta pendientes.'
                    : `${count} usuario(s) con favoritos que están en oferta.`;
                if (preview && data.notifications?.length > 0) {
                    preview.innerHTML = data.notifications.slice(0, 5).map((n: WishlistNotif) =>
                        `<div class="flex items-center justify-between bg-rose-50 border border-rose-100 rounded-lg px-3 py-1.5 gap-2">
                            <span class="text-rose-800 font-medium truncate">${n.product_name ?? ''}</span>
                            <span class="text-rose-600 shrink-0">${n.discount_percentage ?? 0}% dto · T.${n.size ?? ''}</span>
                        </div>`
                    ).join('');
                    preview.classList.remove('hidden');
                } else if (preview) {
                    preview.classList.add('hidden');
                }
            }
        } catch (e) {
        } finally {
            refreshIcon?.classList.remove('animate-spin');
        }
    }

    function showWishlistResult(id: string, success: boolean, html: string) {
        const el = document.getElementById(id);
        if (!el) return;
        el.className = `mt-3 p-3 rounded-xl text-xs ${success ? 'bg-status-success-bg text-status-success' : 'bg-status-error-bg text-status-error'}`;
        el.innerHTML = html;
        el.classList.remove('hidden');
    }

    document.getElementById('wishlist-refresh-btn')?.addEventListener('click', loadWishlistStatus);

    document.getElementById('wishlist-lowstock-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('wishlist-lowstock-btn') as HTMLButtonElement | null;
        if (!btn) return;
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg><span>Enviando...</span>';
        try {
            const res = await fetch('/api/admin/wishlist-notifications', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json() as { success?: boolean; sentCount?: number; markedCount?: number; message?: string; errors?: string[] };
            if (data.success) {
                showWishlistResult('lowstock-result', true,
                    `<strong>✓ ${data.message}</strong>${data.errors?.length ? '<br>Errores: ' + data.errors.join(', ') : ''}`);
                loadWishlistStatus();
            } else {
                showWishlistResult('lowstock-result', false, `Error al enviar notificaciones.`);
            }
        } catch {
            showWishlistResult('lowstock-result', false, 'Error de conexión.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = orig;
        }
    });

    document.getElementById('wishlist-sale-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('wishlist-sale-btn') as HTMLButtonElement | null;
        if (!btn) return;
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg><span>Enviando...</span>';
        try {
            const res = await fetch('/api/admin/wishlist-sale-notifications', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json() as { success?: boolean; sentCount?: number; markedCount?: number; message?: string; errors?: string[] };
            if (data.success) {
                showWishlistResult('sale-result', true,
                    `<strong>✓ ${data.message}</strong>${data.errors?.length ? '<br>Errores: ' + data.errors.join(', ') : ''}`);
                loadWishlistStatus();
            } else {
                showWishlistResult('sale-result', false, `Error al enviar notificaciones.`);
            }
        } catch {
            showWishlistResult('sale-result', false, 'Error de conexión.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = orig;
        }
    });

    // Auto-cargar al arrancar
    loadWishlistStatus();
</script>

<script>
    const checkStockBtn = document.getElementById("check-stock-btn");

    checkStockBtn?.addEventListener("click", async () => {
        const btn = checkStockBtn as HTMLButtonElement;
        const originalContent = btn.innerHTML;

        // Mostrar estado de carga
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Verificando inventario...</span>
        `;

        try {
            const response = await fetch("/api/check-stock-alerts", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
            });

            const result = await response.json();

            if (result.success) {
                let message = "";

                if (result.outOfStock === 0 && result.lowStock === 0) {
                    message = "[\u2713] No hay productos con stock bajo ni agotados.";
                } else {
                    const parts = [];
                    if (result.outOfStock > 0) {
                        parts.push(
                            `[!] ${result.outOfStock} producto(s) agotado(s)`,
                        );
                    }
                    if (result.lowStock > 0) {
                        parts.push(
                            `[\u26A0] ${result.lowStock} producto(s) con stock bajo`,
                        );
                    }
                    message = parts.join("\n");

                    if (
                        result.emailsSent.outOfStock ||
                        result.emailsSent.lowStock
                    ) {
                        message += "\n\nAlertas enviadas por email.";
                    } else {
                        message +=
                            "\n\n[\u26A0] No se pudieron enviar los emails. Verifica la configuración de Resend.";
                    }
                }

                alert(message);
            } else {
                alert("[Error] " + (result.error || "Error desconocido"));
            }
        } catch (error) {
            (window as any).vantageNotify?.(
                "Error al verificar el inventario.",
                "error",
            );
            alert("[Error] Error al verificar el inventario");
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    });
</script>

<!-- Script Dashboard Ejecutivo con Chart.js -->
<script>
    import Chart from "chart.js/auto";

    // Formatear precio
    function formatPrice(cents: number): string {
        return (cents / 100).toLocaleString("es-ES", {
            style: "currency",
            currency: "EUR",
        });
    }

    // Cargar analytics
    async function loadAnalytics() {
        try {
            const response = await fetch("/api/admin/analytics", {
                credentials: "include",
            });

            if (!response.ok) {
                if (response.status === 401) {
                    (window as any).vantageNotify?.(
                        "Tu sesión de administrador expiró. Inicia sesión de nuevo.",
                        "warning",
                    );
                    return;
                }

                (window as any).vantageNotify?.(
                    `Error al cargar analíticas (HTTP ${response.status}).`,
                    "error",
                );
                return;
            }

            const data = await response.json();

            if (!data.success) {
                (window as any).vantageNotify?.(
                    "No se pudieron cargar las analíticas del dashboard.",
                    "warning",
                );
                return;
            }

            // Actualizar KPIs
            const monthlySalesEl = document.getElementById("kpi-monthly-sales");
            const pendingOrdersEl =
                document.getElementById("kpi-pending-orders");
            const topProductEl = document.getElementById("kpi-top-product");
            const topProductSoldEl = document.getElementById(
                "kpi-top-product-sold",
            );
            const chartTotalEl = document.getElementById("chart-total");

            if (monthlySalesEl) {
                monthlySalesEl.textContent = formatPrice(
                    data.kpis.monthlySales,
                );
            }

            if (pendingOrdersEl) {
                pendingOrdersEl.textContent =
                    data.kpis.pendingOrders.toString();
            }

            if (topProductEl && data.kpis.topProduct) {
                topProductEl.textContent = data.kpis.topProduct.name;
                if (topProductSoldEl) {
                    topProductSoldEl.textContent = `${data.kpis.topProduct.sold} vendidos este mes`;
                }
            } else if (topProductEl) {
                topProductEl.textContent = "Sin ventas";
                if (topProductSoldEl) {
                    topProductSoldEl.textContent = "Aún no hay ventas este mes";
                }
            }

            // KPI Devoluciones
            const pendingReturnsEl = document.getElementById("kpi-pending-returns");
            const monthlyRefundsEl = document.getElementById("kpi-monthly-refunds");
            if (pendingReturnsEl) {
                pendingReturnsEl.textContent = (data.kpis.pendingReturns || 0).toString();
            }
            if (monthlyRefundsEl) {
                monthlyRefundsEl.textContent =
                    `Pendientes · ${formatPrice(data.kpis.monthlyRefunds || 0)} reembolsado este mes`;
            }

            // Total de los últimos 7 días
            const weekTotal = data.salesChart.data.reduce(
                (sum: number, val: number) => sum + val,
                0,
            );
            if (chartTotalEl) {
                chartTotalEl.textContent = `Total ventas: ${formatPrice(weekTotal)}`;
            }

            // Renderizar gráfico de Ventas vs Reembolsos
            const canvas = document.getElementById(
                "salesChart",
            ) as HTMLCanvasElement;
            if (canvas) {
                const ctx = canvas.getContext("2d");
                if (ctx) {
                    new Chart(ctx, {
                        type: "bar",
                        data: {
                            labels: data.salesChart.labels,
                            datasets: [
                                {
                                    label: "Ventas (€)",
                                    data: data.salesChart.data.map(
                                        (v: number) => v / 100,
                                    ),
                                    backgroundColor: "rgba(124, 58, 237, 0.8)",
                                    borderColor: "rgba(124, 58, 237, 1)",
                                    borderWidth: 2,
                                    borderRadius: 6,
                                    borderSkipped: false,
                                },
                                {
                                    label: "Reembolsos (€)",
                                    data: (data.salesChart.refundsData || []).map(
                                        (v: number) => v / 100,
                                    ),
                                    backgroundColor: "rgba(239, 68, 68, 0.7)",
                                    borderColor: "rgba(239, 68, 68, 1)",
                                    borderWidth: 2,
                                    borderRadius: 6,
                                    borderSkipped: false,
                                },
                            ],
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: true,
                                    position: "top",
                                    labels: { boxWidth: 12, font: { size: 11 } }
                                },
                                tooltip: {
                                    backgroundColor: "#1a2744",
                                    titleColor: "#fff",
                                    bodyColor: "#fff",
                                    padding: 12,
                                    cornerRadius: 8,
                                    callbacks: {
                                        label: function (context) {
                                            return `${context.dataset.label}: ${formatPrice((context.raw as number) * 100)}`;
                                        },
                                    },
                                },
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: { color: "rgba(0, 0, 0, 0.05)" },
                                    ticks: {
                                        callback: function (value) {
                                            return formatPrice((value as number) * 100);
                                        },
                                    },
                                },
                                x: { grid: { display: false } },
                            },
                        },
                    });
                }
            }

            // Renderizar gráfico de Devoluciones por Estado
            const returnsCanvas = document.getElementById("returnsChart") as HTMLCanvasElement;
            const returnsTotalEl = document.getElementById("returns-total");
            if (returnsCanvas && data.returnsChart) {
                const statusLabels: Record<string, string> = {
                    pending: "Pendiente",
                    in_transit: "En tránsito",
                    received: "Recibida",
                    refunded: "Reembolsada",
                    rejected: "Rechazada",
                };
                const byStatus = data.returnsChart.byStatus || {};
                const statusKeys = Object.keys(statusLabels);
                const vals = statusKeys.map(k => byStatus[k] || 0);
                const total = vals.reduce((a: number, b: number) => a + b, 0);

                if (returnsTotalEl) {
                    returnsTotalEl.textContent = `${total} devoluciones este mes`;
                }

                if (total === 0) {
                    // No hay devoluciones: placeholder
                    const rctx = returnsCanvas.getContext("2d");
                    if (rctx) {
                        new Chart(rctx, {
                            type: "doughnut",
                            data: {
                                labels: ["Sin devoluciones"],
                                datasets: [{
                                    data: [1],
                                    backgroundColor: ["rgba(209, 213, 219, 0.5)"],
                                    borderWidth: 0,
                                }],
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: { enabled: false },
                                },
                            },
                        });
                    }
                    if (returnsTotalEl) returnsTotalEl.textContent = "Sin devoluciones este mes";
                } else {
                    const colors = [
                        "rgba(251, 191, 36, 0.85)",   // pending - amber
                        "rgba(96, 165, 250, 0.85)",   // in_transit - blue
                        "rgba(52, 211, 153, 0.85)",   // received - green
                        "rgba(124, 58, 237, 0.85)",   // refunded - purple
                        "rgba(239, 68, 68, 0.85)",    // rejected - red
                    ];
                    const rctx = returnsCanvas.getContext("2d");
                    if (rctx) {
                        new Chart(rctx, {
                            type: "doughnut",
                            data: {
                                labels: statusKeys.map(k => statusLabels[k]),
                                datasets: [{
                                    data: vals,
                                    backgroundColor: colors,
                                    borderWidth: 2,
                                    borderColor: "#fff",
                                }],
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: "bottom",
                                        labels: { boxWidth: 12, font: { size: 11 }, padding: 10 }
                                    },
                                    tooltip: {
                                        backgroundColor: "#1a2744",
                                        titleColor: "#fff",
                                        bodyColor: "#fff",
                                        padding: 10,
                                        cornerRadius: 8,
                                        callbacks: {
                                            label: function(context) {
                                                const v = context.raw as number;
                                                const pct = total > 0 ? Math.round((v / total) * 100) : 0;
                                                return `${context.label}: ${v} (${pct}%)`;
                                            }
                                        }
                                    },
                                },
                            },
                        });
                    }
                }
            }
        } catch (error) {
            (window as any).vantageNotify?.(
                "Error de conexión al cargar analíticas.",
                "error",
            );
        }
    }

    // Cargar al inicializar
    loadAnalytics();
</script>

