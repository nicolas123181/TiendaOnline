---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getProducts, getCategories, supabase } from "../../lib/supabase";
import { formatPrice } from "../../lib/utils";

// SSR protegido
export const prerender = false;

// Obtener estadísticas
const products = await getProducts(true);
const categories = await getCategories();

const totalProducts = products.length;
const totalStock = products.reduce((sum, p) => sum + p.stock, 0);
const lowStockProducts = products.filter((p) => p.stock > 0 && p.stock < 6);
const outOfStockProducts = products.filter((p) => p.stock < 1);
const featuredProducts = products.filter((p) => p.featured);

const { count: lowStockSizesCount } = await supabase
    .from("product_sizes")
    .select("id", { count: "exact", head: true })
    .lt("stock", 5);

// Valor total del inventario
const inventoryValue = products.reduce((sum, p) => sum + p.price * p.stock, 0);

// Helper para clase de badge de stock
function getStockBadgeClass(stock: number): string {
    if (stock < 1) return "bg-status-error-bg text-status-error";
    if (stock < 6) return "bg-status-warning-bg text-status-warning";
    return "bg-status-success-bg text-status-success";
}
---

<AdminLayout title="Dashboard">
    <!-- ========================================== -->
    <!-- DASHBOARD EJECUTIVO - ANALYTICS -->
    <!-- ========================================== -->
    <section class="mb-10">
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6"
        >
            <div>
                <h2
                    class="text-lg sm:text-xl font-bold text-brand-navy flex items-center gap-2"
                >
                    <span
                        class="w-7 h-7 sm:w-8 sm:h-8 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-lg flex items-center justify-center"
                    >
                        <svg
                            class="w-4 h-4 sm:w-5 sm:h-5 text-white"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                            ></path>
                        </svg>
                    </span>
                    Dashboard Ejecutivo
                </h2>
                <p class="text-xs sm:text-sm text-text-muted mt-1">
                    Métricas clave para tomar decisiones rápidas
                </p>
            </div>
            <span
                class="text-xs text-text-muted bg-surface-tertiary px-3 py-1 rounded-full self-start sm:self-auto"
            >
                Actualizado ahora
            </span>
        </div>

        <!-- KPIs de Negocio -->
        <div
            class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-6"
        >
            <!-- Ventas del Mes -->
            <div
                class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl p-5 sm:p-6 text-white shadow-lg"
            >
                <div class="flex items-center justify-between mb-3 sm:mb-4">
                    <div class="p-2 bg-white/20 rounded-lg">
                        <svg
                            class="w-5 h-5 sm:w-6 sm:h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                    <span class="text-xs bg-white/20 px-2 py-1 rounded-full"
                        >Este mes</span
                    >
                </div>
                <h3
                    id="kpi-monthly-sales"
                    class="text-2xl sm:text-3xl font-bold mb-1"
                >
                    --
                </h3>
                <p class="text-emerald-100 text-xs sm:text-sm">Ventas Totales</p>
            </div>

            <!-- Pedidos Pendientes -->
            <div
                class="bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl p-5 sm:p-6 text-white shadow-lg"
            >
                <div class="flex items-center justify-between mb-3 sm:mb-4">
                    <div class="p-2 bg-white/20 rounded-lg">
                        <svg
                            class="w-5 h-5 sm:w-6 sm:h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                            ></path>
                        </svg>
                    </div>
                    <span class="text-xs bg-white/20 px-2 py-1 rounded-full"
                        >Por enviar</span
                    >
                </div>
                <h3
                    id="kpi-pending-orders"
                    class="text-2xl sm:text-3xl font-bold mb-1"
                >
                    --
                </h3>
                <p class="text-amber-100 text-xs sm:text-sm">Pedidos Pendientes</p>
            </div>

            <!-- Producto Más Vendido -->
            <div
                class="bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl p-5 sm:p-6 text-white shadow-lg"
            >
                <div class="flex items-center justify-between mb-3 sm:mb-4">
                    <div class="p-2 bg-white/20 rounded-lg">
                        <svg
                            class="w-5 h-5 sm:w-6 sm:h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                            ></path>
                        </svg>
                    </div>
                    <span class="text-xs bg-white/20 px-2 py-1 rounded-full"
                        >★ Top</span
                    >
                </div>
                <h3
                    id="kpi-top-product"
                    class="text-base sm:text-xl font-bold truncate mb-1"
                >
                    Cargando...
                </h3>
                <p
                    id="kpi-top-product-sold"
                    class="text-purple-100 text-xs sm:text-sm"
                >
                    Producto Más Vendido
                </p>
            </div>

            <!-- Devoluciones Pendientes -->
            <div
                class="bg-gradient-to-br from-rose-500 to-red-600 rounded-2xl p-5 sm:p-6 text-white shadow-lg"
            >
                <div class="flex items-center justify-between mb-3 sm:mb-4">
                    <div class="p-2 bg-white/20 rounded-lg">
                        <svg
                            class="w-5 h-5 sm:w-6 sm:h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                            ></path>
                        </svg>
                    </div>
                    <span class="text-xs bg-white/20 px-2 py-1 rounded-full">Devoluciones</span>
                </div>
                <h3
                    id="kpi-pending-returns"
                    class="text-2xl sm:text-3xl font-bold mb-1"
                >
                    --
                </h3>
                <p id="kpi-monthly-refunds" class="text-rose-100 text-xs sm:text-sm">
                    Pendientes · --€ reembolsado este mes
                </p>
            </div>
        </div>

        <!-- Gráficos: Ventas + Devoluciones -->
        <div class="grid lg:grid-cols-2 gap-4 sm:gap-6">
            <!-- Gráfico de Ventas / Reembolsos -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4 sm:mb-6">
                    <h3
                        class="font-semibold text-brand-navy flex items-center gap-2 text-sm sm:text-base"
                    >
                        <svg
                            class="w-4 h-4 sm:w-5 sm:h-5 text-brand-leather"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"
                            ></path>
                        </svg>
                        Ventas vs Reembolsos (7 días)
                    </h3>
                    <span
                        id="chart-total"
                        class="text-xs sm:text-sm font-medium text-text-muted">--</span
                    >
                </div>
                <div class="h-56 sm:h-64">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>

            <!-- Gráfico de Devoluciones por Estado -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4 sm:mb-6">
                    <h3
                        class="font-semibold text-brand-navy flex items-center gap-2 text-sm sm:text-base"
                    >
                        <svg
                            class="w-4 h-4 sm:w-5 sm:h-5 text-rose-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                            ></path>
                        </svg>
                        Devoluciones por Estado (mes actual)
                    </h3>
                    <span
                        id="returns-total"
                        class="text-xs sm:text-sm font-medium text-text-muted">--</span
                    >
                </div>
                <div class="h-56 sm:h-64 flex items-center justify-center">
                    <canvas id="returnsChart"></canvas>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- INVENTARIO - Stats Grid Original -->
    <!-- ========================================== -->
    <section class="mb-8">
        <h2
            class="text-base sm:text-lg font-semibold text-brand-navy mb-4 flex items-center gap-2"
        >
            <svg
                class="w-4 h-4 sm:w-5 sm:h-5 text-text-muted"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                ></path>
            </svg>
            Estado del Inventario
        </h2>
        <div
            class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6"
        >
            <!-- Total Products -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex items-center justify-between mb-4">
                    <div class="p-3 bg-blue-100 rounded-xl">
                        <svg
                            class="w-6 h-6 text-blue-600"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                            ></path>
                        </svg>
                    </div>
                    <span
                        class="text-xs font-medium text-status-success bg-status-success-bg px-2 py-1 rounded-full"
                    >
                        Activo
                    </span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-brand-navy">
                    {totalProducts}
                </h3>
                <p class="text-sm text-text-muted mt-1">Total de productos</p>
            </div>

            <!-- Total Stock -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex items-center justify-between mb-4">
                    <div class="p-3 bg-green-100 rounded-xl">
                        <svg
                            class="w-6 h-6 text-green-600"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
                            ></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-brand-navy">
                    {totalStock}
                </h3>
                <p class="text-sm text-text-muted mt-1">Unidades en stock</p>
            </div>

            <!-- Low Stock Alert -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex items-center justify-between mb-4">
                    <div class="p-3 bg-amber-100 rounded-xl">
                        <svg
                            class="w-6 h-6 text-amber-600"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            ></path>
                        </svg>
                    </div>
                    {
                        (lowStockSizesCount || 0) > 0 && (
                            <span class="text-xs font-medium text-status-warning bg-status-warning-bg px-2 py-1 rounded-full">
                                Atención
                            </span>
                        )
                    }
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-brand-navy">
                    {lowStockSizesCount || 0}
                </h3>
                <p class="text-sm text-text-muted mt-1">
                    Tallas con bajo stock
                </p>
            </div>

            <!-- Inventory Value -->
            <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
                <div class="flex items-center justify-between mb-4">
                    <div class="p-3 bg-purple-100 rounded-xl">
                        <svg
                            class="w-6 h-6 text-purple-600"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-xl sm:text-3xl font-bold text-brand-navy">
                    {formatPrice(inventoryValue)}
                </h3>
                <p class="text-sm text-text-muted mt-1">Valor del inventario</p>
            </div>
        </div>
    </section>

    <!-- Quick Actions & Alerts -->
    <div class="grid lg:grid-cols-2 gap-4 sm:gap-6 mb-8">
        <!-- Quick Actions -->
        <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
            <h2 class="text-base sm:text-lg font-semibold text-brand-navy mb-4">
                Acciones Rápidas
            </h2>
            <div
                id="quick-actions-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3"
            >
                <a
                    href="/admin/productos/nuevo"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-brand-navy text-white rounded-xl hover:bg-brand-navy-light transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Nuevo Producto</span>
                </a>
                <a
                    href="/admin/productos"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-surface-tertiary text-brand-navy rounded-xl hover:bg-brand-cream transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                        ></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Productos</span>
                </a>
                <a
                    href="/admin/pedidos"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-surface-tertiary text-brand-navy rounded-xl hover:bg-brand-cream transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                        ></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Pedidos</span>
                </a>
                <a
                    href="/admin/categorias"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-surface-tertiary text-brand-navy rounded-xl hover:bg-brand-cream transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                        ></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Categorías</span>
                </a>
                <a
                    href="/admin/tallas"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-surface-tertiary text-brand-navy rounded-xl hover:bg-brand-cream transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 6L3 9m0 0l3 3m-3-3h18M18 18l3-3m0 0l-3-3m3 3H3"
                        ></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Tallas</span>
                </a>
                <a
                    href="/admin/newsletter"
                    class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-2 sm:gap-3 p-3 sm:p-4 bg-surface-tertiary text-brand-navy rounded-xl hover:bg-brand-cream transition-colors"
                >
                    <svg
                        class="w-5 h-5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                    </svg>
                    <span class="font-medium text-xs sm:text-sm text-center sm:text-left">Newsletter</span>
                </a>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="bg-surface-primary rounded-2xl p-4 sm:p-6 shadow-soft">
            <h2 class="text-base sm:text-lg font-semibold text-brand-navy mb-4">
                Alertas de Stock
            </h2>

            {
                lowStockProducts.length > 0 || outOfStockProducts.length > 0 ? (
                    <div class="space-y-3 max-h-62.5 overflow-y-auto">
                        {outOfStockProducts.map((product) => (
                            <div class="flex items-center justify-between p-3 bg-status-error-bg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-white rounded-lg overflow-hidden">
                                        <img
                                            src={
                                                product.images?.[0] ||
                                                "/placeholder-product.jpg"
                                            }
                                            alt={product.name}
                                            class="w-full h-full object-cover"
                                        />
                                    </div>
                                    <div>
                                        <p class="font-medium text-sm text-brand-navy line-clamp-1">
                                            {product.name}
                                        </p>
                                        <p class="text-xs text-status-error">
                                            Sin stock
                                        </p>
                                    </div>
                                </div>
                                <a
                                    href={`/admin/productos/${product.id}`}
                                    class="text-xs font-medium text-status-error hover:underline"
                                >
                                    Gestionar
                                </a>
                            </div>
                        ))}
                        {lowStockProducts.map((product) => (
                            <div class="flex items-center justify-between p-3 bg-status-warning-bg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-white rounded-lg overflow-hidden">
                                        <img
                                            src={
                                                product.images?.[0] ||
                                                "/placeholder-product.jpg"
                                            }
                                            alt={product.name}
                                            class="w-full h-full object-cover"
                                        />
                                    </div>
                                    <div>
                                        <p class="font-medium text-sm text-brand-navy line-clamp-1">
                                            {product.name}
                                        </p>
                                        <p class="text-xs text-status-warning">
                                            {product.stock} unidades
                                        </p>
                                    </div>
                                </div>
                                <a
                                    href={`/admin/productos/${product.id}`}
                                    class="text-xs font-medium text-status-warning hover:underline"
                                >
                                    Gestionar
                                </a>
                            </div>
                        ))}
                    </div>
                ) : (
