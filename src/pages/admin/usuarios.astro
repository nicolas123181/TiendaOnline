---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase, isSupabaseConfigured } from "../../lib/supabase";

// Verificar si Supabase está configurado
if (!isSupabaseConfigured) {
    return Astro.redirect("/admin/login?error=config");
}

// Obtener usuarios desde auth.users (requiere service_role key)
// Como alternativa, obtenemos los emails únicos de los pedidos
const { data: ordersData } = await supabase
    .from("orders")
    .select("customer_email, customer_name, customer_phone, created_at")
    .order("created_at", { ascending: false });

// Agrupar por email para obtener usuarios únicos con estadísticas
const usersMap = new Map<
    string,
    {
        email: string;
        name: string;
        phone: string | null;
        ordersCount: number;
        lastOrder: string;
        firstOrder: string;
    }
>();

if (ordersData) {
    for (const order of ordersData) {
        const existing = usersMap.get(order.customer_email);
        if (existing) {
            existing.ordersCount++;
            // El primer pedido en la iteración es el más reciente (ordenado desc)
            if (!existing.lastOrder) {
                existing.lastOrder = order.created_at;
            }
            existing.firstOrder = order.created_at;
        } else {
            usersMap.set(order.customer_email, {
                email: order.customer_email,
                name: order.customer_name,
                phone: order.customer_phone,
                ordersCount: 1,
                lastOrder: order.created_at,
                firstOrder: order.created_at,
            });
        }
    }
}

const users = Array.from(usersMap.values()).sort(
    (a, b) => new Date(b.lastOrder).getTime() - new Date(a.lastOrder).getTime(),
);

// Obtener suscriptores de newsletter
const { data: subscribers } = await supabase
    .from("newsletter_subscribers")
    .select("email, subscribed_at")
    .order("subscribed_at", { ascending: false });

const subscriberEmails = new Set(subscribers?.map((s) => s.email) || []);

// Función para formatear fecha
function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    });
}
---

<AdminLayout title="Gestión de Usuarios">
    <div class="page-header">
        <h1><svg class="w-6 h-6 inline -mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg> Gestión de Usuarios</h1>
        <p>Clientes que han realizado pedidos en la tienda</p>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg></div>
            <div class="stat-content">
                <span class="stat-number">{users.length}</span>
                <span class="stat-label">Clientes Únicos</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>
            <div class="stat-content">
                <span class="stat-number">{ordersData?.length || 0}</span>
                <span class="stat-label">Pedidos Totales</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
            <div class="stat-content">
                <span class="stat-number">{subscribers?.length || 0}</span>
                <span class="stat-label">Suscriptores Newsletter</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon gold"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg></div>
            <div class="stat-content">
                <span class="stat-number"
                    >{users.filter((u) => u.ordersCount >= 2).length}</span
                >
                <span class="stat-label">Clientes Recurrentes</span>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card filters-card">
        <div class="filters">
            <div class="search-box">
                <input
                    type="text"
                    id="search-input"
                    placeholder="Buscar por nombre o email..."
                />
            </div>
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all"
                    >Todos</button
                >
                <button class="filter-btn" data-filter="recurring"
                    >Recurrentes (2+)</button
                >
                <button class="filter-btn" data-filter="newsletter"
                    >Suscriptores</button
                >
            </div>
        </div>
    </div>

    <!-- Lista de usuarios -->
    <div class="card">
        <h2><svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg> Lista de Clientes ({users.length})</h2>

        {
            users.length === 0 ? (
                <div class="empty-state">
                    <p>No hay clientes registrados aún</p>
                </div>
            ) : (
                <div class="users-table-wrapper">
                    <table class="users-table" id="users-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Pedidos</th>
                                <th>Último Pedido</th>
                                <th>Newsletter</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {users.map((user) => (
                                <tr
                                    data-email={user.email.toLowerCase()}
                                    data-name={user.name.toLowerCase()}
                                    data-recurring={
                                        user.ordersCount >= 2 ? "true" : "false"
                                    }
                                    data-newsletter={
                                        subscriberEmails.has(user.email)
                                            ? "true"
                                            : "false"
                                    }
                                >
                                    <td class="user-cell" data-label="">
                                        <div class="user-avatar">
                                            {user.name.charAt(0).toUpperCase()}
                                        </div>
                                        <div class="user-info">
                                            <span class="user-name">
                                                {user.name}
                                            </span>
                                            {user.ordersCount >= 3 && (
                                                <span class="vip-badge">
                                                    <svg class="w-3 h-3 inline -mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg> VIP
                                                </span>
                                            )}
                                        </div>
                                    </td>
                                    <td class="email-cell" data-label="Email">{user.email}</td>
                                    <td data-label="Teléfono">{user.phone || "—"}</td>
                                    <td data-label="Pedidos">
                                        <span
                                            class={`orders-badge ${user.ordersCount >= 2 ? "recurring" : ""}`}
                                        >
                                            {user.ordersCount}{" "}
                                            {user.ordersCount === 1
                                                ? "pedido"
                                                : "pedidos"}
                                        </span>
                                    </td>
                                    <td data-label="Último pedido">{formatDate(user.lastOrder)}</td>
                                    <td data-label="Newsletter">
                                        {subscriberEmails.has(user.email) ? (
                                            <span class="status-badge subscribed">
                                                <svg class="w-3 h-3 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Suscrito
                                            </span>
                                        ) : (
                                            <span class="status-badge not-subscribed">
                                                No suscrito
                                            </span>
                                        )}
                                    </td>
                                    <td class="actions-cell" data-label="">
                                        <a
                                            href={`/admin/pedidos?email=${encodeURIComponent(user.email)}`}
                                            class="btn btn-sm btn-secondary"
                                        >
                                            Ver Pedidos
                                        </a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )
        }
    </div>

    <!-- Suscriptores sin compras -->
    {
        subscribers && subscribers.length > 0 && (
            <div class="card">
                <h2><svg class="w-5 h-5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg> Suscriptores sin Compras</h2>
                <p class="section-description">
                    Personas suscritas al newsletter que aún no han realizado
                    ninguna compra.
                </p>

                <div class="subscribers-grid">
                    {subscribers
                        .filter((s) => !usersMap.has(s.email))
                        .slice(0, 20)
                        .map((subscriber) => (
                            <div class="subscriber-card">
                                <span class="subscriber-email">
                                    {subscriber.email}
                                </span>
                                <span class="subscriber-date">
                                    Desde {formatDate(subscriber.subscribed_at)}
                                </span>
                            </div>
                        ))}
                    {subscribers.filter((s) => !usersMap.has(s.email)).length >
                        20 && (
                        <div class="more-subscribers">
                            +
                            {subscribers.filter((s) => !usersMap.has(s.email))
                                .length - 20}{" "}
                            más
                        </div>
                    )}
                </div>
            </div>
        )
    }
</AdminLayout>

